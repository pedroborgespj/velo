# Supabase (frontend) — em produção/preview os valores vêm da Vercel (env vars por ambiente).
# Localmente, aponte para o projeto de PREVIEW (nunca produção).
VITE_SUPABASE_PROJECT_ID="<project-ref>"
VITE_SUPABASE_PUBLISHABLE_KEY="<publishable-ou-anon-key>"
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"

# Testes E2E — conexão Postgres (use o Session Pooler, compatível com IPv4/CI).
# Local: aponte para PREVIEW. No CI, o valor vem do secret PREVIEW_DATABASE_URL.
DATABASE_URL="postgresql://postgres.<project-ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres"
